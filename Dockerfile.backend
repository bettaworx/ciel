# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.27.3-bookworm AS build
WORKDIR /src

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

COPY apps/backend/go.mod apps/backend/go.sum ./
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    go mod download

RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1

ARG TARGETARCH

# Installed as cmd/migrate@<version> at the version go.mod requires, so that go.mod need
# not list the dependencies of drivers a postgres build never links. go install puts a
# cross-compiled binary under /go/bin/linux_<arch>/, hence the find. Depends only on
# go.mod, so it stays cached across source changes as long as it comes before the COPY
# below.
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build \
    version=$(go list -m -f '{{.Version}}' github.com/golang-migrate/migrate/v4) && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go install -tags postgres -trimpath \
      "github.com/golang-migrate/migrate/v4/cmd/migrate@${version}" && \
    mkdir -p /out && find /go/bin -name migrate -type f -exec cp {} /out/migrate \;

COPY packages/api /packages/api
COPY apps/backend ./

RUN go generate ./internal/db/sqlc
RUN go generate ./internal/api

ARG BUILD_VERSION=dev
ARG BUILD_COMMIT=dev
ARG BUILD_BRANCH=dev
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X backend/internal/version.Version=${BUILD_VERSION} -X backend/internal/version.Commit=${BUILD_COMMIT} -X backend/internal/version.Branch=${BUILD_BRANCH}" \
    -o /out/backend .

FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/backend /app/backend
COPY --from=build /out/migrate /app/migrate
COPY --from=build /src/db/migrations /app/db/migrations
COPY apps/backend/scripts/migrate-db.sh /app/migrate-db
RUN chmod +x /app/migrate-db

# Last, because a new commit value invalidates every instruction after it.
ARG BUILD_VERSION=dev
ARG BUILD_COMMIT=dev
ARG BUILD_BRANCH=dev
LABEL org.opencontainers.image.version=${BUILD_VERSION}
LABEL org.opencontainers.image.revision=${BUILD_COMMIT}
LABEL org.opencontainers.image.ref.name=${BUILD_BRANCH}

EXPOSE 6137
CMD ["/app/backend"]
