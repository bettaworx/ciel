# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS base

FROM base AS deps
WORKDIR /app

COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY packages/kotodoki/package.json ./packages/kotodoki/package.json

# CI/release builds require an up-to-date pnpm-lock.yaml; fail fast on lockfile drift.
# Corepack's download can hit transient ECONNRESETs against registry.npmjs.org,
# so retry a few times before giving up.
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    for i in 1 2 3; do \
      corepack enable pnpm && break; \
      echo "corepack enable failed (attempt $i), retrying..."; \
      sleep $((i * 3)); \
    done && \
    pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app

ARG BUILD_COMMIT=dev
ARG BUILD_BRANCH=dev
ENV BUILD_COMMIT=${BUILD_COMMIT}
ENV BUILD_BRANCH=${BUILD_BRANCH}

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/frontend/node_modules ./apps/frontend/node_modules
COPY --from=deps /app/packages/kotodoki/node_modules ./packages/kotodoki/node_modules
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend ./apps/frontend
COPY packages/api ./packages/api
COPY packages/kotodoki ./packages/kotodoki

WORKDIR /app/apps/frontend
# Retry for the same transient registry/network issue as the deps stage.
RUN for i in 1 2 3; do \
      corepack enable pnpm && break; \
      echo "corepack enable failed (attempt $i), retrying..."; \
      sleep $((i * 3)); \
    done
# The API types are not covered by a lifecycle script, so generate them first.
# `build` then runs `prebuild` itself, which builds kotodoki and the licence
# manifest — running gen:licenses here as well would just do it twice.
RUN pnpm run gen:openapi
RUN pnpm run build

# The output is a static bundle, so the runtime is a web server and nothing
# else: no Node, no native image libraries. Link previews and icon resizing
# moved to the backend, and the SPA is the same bytes for every deployment.
FROM nginx:1.29-alpine AS runner

ARG BUILD_COMMIT=dev
ARG BUILD_BRANCH=dev
LABEL org.opencontainers.image.revision=${BUILD_COMMIT}
LABEL org.opencontainers.image.ref.name=${BUILD_BRANCH}

COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html
COPY nginx/frontend/default.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/frontend/40-ciel-config.sh /docker-entrypoint.d/40-ciel-config.sh
RUN chmod +x /docker-entrypoint.d/40-ciel-config.sh

# envsubst only touches the names matching this filter, so nginx's own
# $variables survive the template step. Everything else this server needs
# (API_BASE_URL, INTERNAL_API_BASE_URL, PUBLIC_BASE_URL) is read at container
# start by nginx/frontend/40-ciel-config.sh.
ENV PORT=3000
ENV NGINX_ENVSUBST_FILTER='^PORT$'

# CSP defaults, overridable per deployment. Each maps to one directive; unset
# means "use what the app needs" (see nginx/frontend/40-ciel-config.sh).
ENV CSP_DEFAULT_SRC=""
ENV CSP_SCRIPT_SRC=""
ENV CSP_STYLE_SRC=""
ENV CSP_IMG_SRC=""
ENV CSP_FONT_SRC=""
ENV CSP_CONNECT_SRC=""
ENV CSP_MEDIA_SRC=""
ENV CSP_OBJECT_SRC=""
ENV CSP_FRAME_SRC=""
ENV CSP_BASE_URI=""
ENV CSP_FORM_ACTION=""
ENV CSP_FRAME_ANCESTORS=""

EXPOSE 3000
