
# Backend environment (prod or dev)
# Development is the default if not set
ENV=development

# Public backend API base URL — used by browsers.
# Set this to the address that users' browsers can reach.
API_BASE_URL=http://localhost:6137

# Internal backend API base URL — used only by the frontend's own web server
# to proxy the PWA manifest so the browser sees it same-origin.
# This is not a browser API URL and is not used for backend REST proxying.
# In Docker Compose this should point at the backend service name.
INTERNAL_API_BASE_URL=http://ciel-backend:6137

# Public-facing backend base URL — used by the backend to build absolute media URLs.
# In the independent-port setup this is the backend URL, not the frontend URL.
PUBLIC_BASE_URL=http://localhost:6137

# Backend Server Port (Default: 6137)
BACKEND_PORT=6137

# Frontend Server Port (Default: 3000)
# The dev server refuses to start if this port is taken rather than moving to
# the next one: the browser calls the backend cross-origin, so a different port
# would fail every request on CORS. Change this and ALLOWED_ORIGINS together.
FRONTEND_PORT=3000

# Hosts allowed to reach the Vite dev/preview server (comma-separated)
# Add your Tailscale IP or LAN IP if accessing the dev server from another device
# Example: DEV_ALLOWED_HOSTS=192.168.1.23
# DEV_ALLOWED_HOSTS=

# Bind address for Docker port publishing
# Use 0.0.0.0 to allow access from other hosts (VPN/LAN)
BIND_ADDR=127.0.0.1

# Allowed CORS origins (comma-separated list, exact match only)
# Frontend origins allowed to call the backend directly. Must match
# FRONTEND_PORT, or the browser gets a CORS error on every API call and the app
# shows its offline screen.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

TRUST_PROXY=true
STEPUP_TOKEN_TTL_SECONDS=300

# --- Two-factor authentication -----------------------------------------------
# TOTP secrets are encrypted at rest with this key. Without it, TOTP enrollment
# is disabled and /auth/mfa/totp/setup answers 503. WebAuthn is unaffected.
# REQUIRED for TOTP: 32 raw bytes, base64-encoded
# Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# WebAuthn relying-party display name, shown by some authenticators during
# registration.
WEBAUTHN_RP_DISPLAY_NAME=Ciel

# WebAuthn RP ID defaults to the host of PUBLIC_BASE_URL, and the allowed
# origins to ALLOWED_ORIGINS, so this is usually fine left unset. It also
# becomes the TOTP issuer, i.e. the name authenticator apps file the account
# under, so it should read as this server address.
# WEBAUTHN_RP_ID=example.com

# Cookie security
# Examples: "example.com" or ".example.com" (with dot to include subdomains)
# Leave empty for development (defaults to current domain)
COOKIE_DOMAIN=

# Redis connection
# Format: redis://:your-password@redis:6379
# REQUIRED in production: minimum 16 characters
# Generate password: openssl rand -base64 32
REDIS_ADDR=redis://:password@redis:6379
REDIS_PASSWORD=password

# Search (Meilisearch)
# SEARCH_PROVIDER selects the search engine: "meilisearch" or "none".
# With "none", the /search endpoints return 503 and nothing is indexed.
SEARCH_PROVIDER=meilisearch
# Host of the Meilisearch instance. Use the compose service name when the
# backend runs in Docker, or http://localhost:7700 when it runs natively.
MEILISEARCH_HOST=http://meilisearch:7700
# REQUIRED when SEARCH_PROVIDER=meilisearch: minimum 16 characters.
# Must match MEILI_MASTER_KEY below. Generate: openssl rand -base64 32
MEILISEARCH_API_KEY=password
MEILI_MASTER_KEY=password
MEILI_PORT=7700
# Set to "force" to reindex everything on the next start. Normally the backfill
# only runs when the index is empty.
SEARCH_BACKFILL=

# Media storage directory
# The server will attempt to create this directory on startup with 0755 permissions
# If initialization fails (e.g., due to insufficient permissions), media uploads will return 503
# Recommended: Use absolute path or ensure the parent directory is writable
# Examples:
#   - Relative path (resolved from working directory): ./data/media
#   - Absolute path: /var/lib/ciel/media
MEDIA_DIR=./data/media

# Realtime WebSocket signing secret (REQUIRED in production)
# REQUIRED: minimum 32 characters
# Generate: openssl rand -base64 32
# DO NOT use placeholder values like "replace" or "changeme"
REALTIME_SIGNING_SECRET=replace
REALTIME_WS_MAX_CONNECTIONS=1000
REALTIME_WS_MAX_CONNECTIONS_PER_IP=50

# PostgreSQL Configuration
POSTGRES_DB=ciel
POSTGRES_USER=ciel
# SECURITY CRITICAL: Set strong password (32+ characters recommended)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=password

# Database connection URL
# IMPORTANT: Use strong password (not the placeholder "ciel")
# Production: MUST NOT contain weak passwords like "ciel", "postgres", "password"
DATABASE_URL=postgres://ciel:password@db:5432/ciel?sslmode=disable

# JWT Secret (REQUIRED in all environments)
# REQUIRED: minimum 32 characters
# Generate: openssl rand -base64 32
JWT_SECRET=replacereplacereplacereplacereplace

# Initial setup password (REQUIRED in all environments)
# After setup is complete, you may remove this from the environment.
INITIAL_SETUP_PASSWORD=your-setup-passphrase-here

# Config file path (optional, defaults to ./config/config.yaml)
CONFIG_PATH=./config/config.yaml

# -------------------------------------------------------------------------
# Content Security Policy (frontend web server)
# -------------------------------------------------------------------------
# Each variable maps directly to a CSP directive. If unset, secure defaults
# are used — see nginx/frontend/40-ciel-config.sh, which assembles the header
# at container start and adds the backend's origins automatically.
#
# Notes:
#   - Values are space-separated, e.g. "'self' https://example.com"
#   - The dev server (pnpm dev) sends the same policy as Report-Only, because
#     Vite injects inline scripts for HMR.
#
# Common additions:
#   Cloudflare Browser Insights: https://static.cloudflareinsights.com
#   jsDelivr CDN:                https://cdn.jsdelivr.net
#   Spotify embeds:              https://open.spotify.com
#   YouTube embeds:              https://www.youtube-nocookie.com
#   X (Twitter) embeds:          https://platform.x.com https://platform.twitter.com https://syndication.twitter.com
#
# CSP_DEFAULT_SRC="'self'"
# CSP_SCRIPT_SRC="'self' https://platform.x.com https://platform.twitter.com https://syndication.twitter.com"
# CSP_STYLE_SRC="'self' 'unsafe-inline'"
# CSP_IMG_SRC="'self' data: blob: https://cdn.jsdelivr.net https://pbs.twimg.com https://abs.twimg.com https://cdn.syndication.twimg.com"
# CSP_FONT_SRC="'self' data:"
# CSP_CONNECT_SRC="'self' https://static.cloudflareinsights.com https://open.spotify.com https://www.youtube-nocookie.com https://cdn.syndication.twimg.com https://syndication.twitter.com https://cdn.jsdelivr.net"
# NOTE: The backend's API_BASE_URL / PUBLIC_BASE_URL origins and the WebSocket
# origin are appended automatically by nginx/frontend/40-ciel-config.sh; do not
# hard-code them here.
# CSP_MEDIA_SRC="'self' blob: https://video.twimg.com"
# CSP_OBJECT_SRC="'none'"
# CSP_FRAME_SRC="'self' https://open.spotify.com https://www.youtube-nocookie.com https://platform.twitter.com https://syndication.twitter.com"
# CSP_BASE_URI="'self'"
# CSP_FORM_ACTION="'self'"
# CSP_FRAME_ANCESTORS="'none'"
