{
  "name": "ciel",
  "version": "2026.1.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "gen:openapi": "cd apps/backend && go generate ./internal/api",
    "gen:openapi:ts": "pnpm -C apps/frontend run gen:openapi",
    "gen:sqlc": "cd apps/backend && go generate ./internal/db/sqlc",
    "gen:backend": "cd apps/backend && go generate ./...",
    "run:backend": "cd apps/backend && go run .",
    "test:backend": "cd apps/backend && go test ./...",
    "dev:frontend": "dotenv -e .env -- pnpm -C apps/frontend run dev",
    "build:frontend": "cd apps/frontend && pnpm run build",
    "build:kotodoki": "pnpm -C packages/kotodoki run build",
    "test:kotodoki": "pnpm -C packages/kotodoki run test",
    "migrate:up": "cd apps/backend && go run -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate -path ./db/migrations -database \"$DATABASE_URL\" up",
    "migrate:down": "cd apps/backend && go run -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate -path ./db/migrations -database \"$DATABASE_URL\" down 1",
    "migrate:down:all": "cd apps/backend && go run -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate -path ./db/migrations -database \"$DATABASE_URL\" down -all",
    "migrate:init": "pnpm migrate:up",
    "gen:openapi:dart": "cd apps/native_app && flutter pub run build_runner build --delete-conflicting-outputs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
