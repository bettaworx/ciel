name: ciel

networks:
  ciel-net:
    driver: bridge

services:
  nginx:
    image: nginx:1-alpine
    container_name: ciel-nginx
    networks:
      - ciel-net
    depends_on:
      - frontend
      - backend
    ports:
      - "${BIND_ADDR:-127.0.0.1}:${HTTP_PORT:-80}:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    restart: unless-stopped

  backend:
    build:
      context: .
      dockerfile: Dockerfile.backend
    container_name: ciel-backend
    networks:
      - ciel-net
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      ENV: ${ENV:-development}
      DISABLE_DOTENV: ${DISABLE_DOTENV:-1}
      PORT: ${BACKEND_PORT:-6137}
      ALLOWED_ORIGINS: ${ALLOWED_ORIGINS:-http://localhost,http://127.0.0.1}
      TRUST_PROXY: ${TRUST_PROXY:-true}
      STEPUP_TOKEN_TTL_SECONDS: ${STEPUP_TOKEN_TTL_SECONDS:-300}
      COOKIE_DOMAIN: ${COOKIE_DOMAIN:-}
      REDIS_ADDR: ${REDIS_ADDR:-redis:6379}
      REDIS_PASSWORD: ${REDIS_PASSWORD:-}
      MEDIA_DIR: ${MEDIA_DIR:-/var/lib/ciel/media}
      PUBLIC_BASE_URL: ${PUBLIC_BASE_URL:-http://localhost}
      REALTIME_SIGNING_SECRET: ${REALTIME_SIGNING_SECRET:?REALTIME_SIGNING_SECRET must be set}
      REALTIME_WS_MAX_CONNECTIONS: ${REALTIME_WS_MAX_CONNECTIONS:-1000}
      REALTIME_WS_MAX_CONNECTIONS_PER_IP: ${REALTIME_WS_MAX_CONNECTIONS_PER_IP:-50}
      JWT_SECRET: ${JWT_SECRET:?JWT_SECRET must be set}
      INITIAL_SETUP_PASSWORD: ${INITIAL_SETUP_PASSWORD:?INITIAL_SETUP_PASSWORD must be set}
      CONFIG_PATH: ${CONFIG_PATH:-/app/config/config.yaml}
      DATABASE_URL: ${DATABASE_URL:-postgres://ciel:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@db:5432/${POSTGRES_DB:-ciel}?sslmode=disable}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}
    volumes:
      - media_data:/var/lib/ciel/media
      - ./apps/backend/config:/app/config

  frontend:
    build:
      context: .
      dockerfile: Dockerfile.frontend
    container_name: ciel-frontend
    networks:
      - ciel-net
    depends_on:
      backend:
        condition: service_started
    environment:
      # Internal backend URL for server-side rendering (SSR) only.
      # Never exposed to the browser — nginx routes /api/v1/ directly to backend.
      API_BASE_URL: ${API_BASE_URL:-http://ciel-backend:6137}
      # Public-facing base URL (used by Next.js image remote patterns).
      # Must match what the browser sees, i.e. the nginx address.
      PUBLIC_BASE_URL: ${PUBLIC_BASE_URL:-http://localhost}
      PORT: ${FRONTEND_PORT:-3000}
      CSP_DEFAULT_SRC: ${CSP_DEFAULT_SRC:-}
      CSP_SCRIPT_SRC: ${CSP_SCRIPT_SRC:-}
      CSP_STYLE_SRC: ${CSP_STYLE_SRC:-}
      CSP_IMG_SRC: ${CSP_IMG_SRC:-}
      CSP_FONT_SRC: ${CSP_FONT_SRC:-}
      CSP_CONNECT_SRC: ${CSP_CONNECT_SRC:-}
      CSP_MEDIA_SRC: ${CSP_MEDIA_SRC:-}
      CSP_OBJECT_SRC: ${CSP_OBJECT_SRC:-}
      CSP_BASE_URI: ${CSP_BASE_URI:-}
      CSP_FORM_ACTION: ${CSP_FORM_ACTION:-}
      CSP_FRAME_ANCESTORS: ${CSP_FRAME_ANCESTORS:-}

  db:
    image: postgres:16-alpine
    container_name: ciel-db
    networks:
      - ciel-net
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-ciel}
      POSTGRES_USER: ${POSTGRES_USER:-ciel}
      # SECURITY CRITICAL: Set strong POSTGRES_PASSWORD in .env file!
      # Generate with: openssl rand -base64 32
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set in .env file}
    ports:
      # SECURITY: Bind to localhost only to prevent external access
      - "127.0.0.1:5432:5432"
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-ciel} -d ${POSTGRES_DB:-ciel}"]
      interval: 3s
      timeout: 3s
      retries: 20

  redis:
    image: redis:7-alpine
    container_name: ciel-redis
    networks:
      - ciel-net
    # SECURITY: Add password protection for Redis
    command: >
      sh -c "
      if [ -n \"$$REDIS_PASSWORD\" ]; then
        redis-server --requirepass \"$$REDIS_PASSWORD\" --appendonly yes
      else
        echo 'WARNING: Redis running without password (development only)'
        redis-server --appendonly yes
      fi
      "
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:-}
    ports:
      # SECURITY: Bind to localhost only to prevent external access
      - "127.0.0.1:6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: >
        sh -c "
        if [ -n \"$$REDIS_PASSWORD\" ]; then
          redis-cli -a \"$$REDIS_PASSWORD\" ping
        else
          redis-cli ping
        fi
        "
      interval: 3s
      timeout: 3s
      retries: 20

volumes:
  db_data:
  media_data:
  redis_data:
